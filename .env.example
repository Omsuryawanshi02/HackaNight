# Environment variables for siteaudit application.

# Database
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# DATABASE_URL=postgres+asyncpg://postgres:postgres@localhost:5432/siteaudit

# Supabase Auth
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Security (fallback / token signing)
SECRET_KEY=dev-secret-key-change-me-to-a-strong-random-value-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=90

# VLM Provider
VLM_PROVIDER=mock
GEMINI_API_KEY=

# OCR
OCR_PROVIDER=tesseract

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads

# Application
PROJECT_TIMEZONE=Asia/Kolkata
MAX_PHOTO_AGE_HOURS=72
OVERCLAIM_TOLERANCE_PCT=20.0
REQUIRED_PHOTO_COUNT=3